    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
