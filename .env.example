
# Docker only: which host address the app is published on.
# 127.0.0.1 = this server only (default; put Tailscale/Caddy in front)
# 0.0.0.0   = every network interface (anyone on your network can open it)
# BIND_ADDRESS=127.0.0.1

# Real-time price stream (Finnhub allows one per API key).
# Default: on in production (Docker / npm start), off for `npm run dev`.
# LIVE_STREAM=on
